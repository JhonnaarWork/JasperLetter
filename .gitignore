# Exclude resources as requested by user (only backend and frontend versioned)
# Anchored to repo root: an unanchored "resources/" also matched backend/src/main/resources/,
# which silently excluded application.properties from version control.
/resources/
*.pdf

# Maven / Java (Backend)
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties

# Frontend (Node / Angular)
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/tmp/
frontend/out-tsc/
frontend/bazel-out/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.sass-cache/
frontend/connect.lock
frontend/coverage/
frontend/libpeerconnection.log
frontend/testem.log
frontend/typings/

# General Logs
*.log

# IDEs and Editors
.idea/
*.iml
.project
.classpath
.settings/
.vscode/
*.sublime-workspace
.history/

# Operating System
.DS_Store
Thumbs.db
desktop.ini
